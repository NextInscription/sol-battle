# Solana Network Configuration
# Copy this file to .env.local and configure for your environment

# RPC Endpoint
# Local development: http://localhost:8899
# Devnet: https://api.devnet.solana.com
# Testnet: https://api.testnet.solana.com
# Mainnet: https://api.mainnet-beta.solana.com
# Or use a custom RPC provider like Helius, QuickNode, Triton, etc.
VITE_RPC_ENDPOINT=http://localhost:8899

# Network environment (localnet | devnet | testnet | mainnet)
VITE_NETWORK=localnet

# Solana Program ID (update after deploying)
VITE_PROGRAM_ID=FzPt8DvFfzG9GUA56Yp22DCPgj8qgm6McCVRKoVYyADK
